{
  "name": "sleek-scroll",
  "version": "1.0.36",
  "description": "Lightweight, customizable React scrollbar with RTL support, zero dependencies, and automatic content size tracking.",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "clean": "rimraf dist",
    "prebuild": "yarn clean && yarn compile:scss",
    "build": "tsc && tsc -p tsconfig.esm.json",
    "compile:scss": "sass src/styles:dist/styles --no-source-map",
    "publish:npm": "npm publish --registry https://registry.npmjs.org/",
    "publish:github": "npm publish --registry https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "types": "./dist/cjs/index.d.ts"
    }
  },
  "keywords": [
    "react",
    "scrollbar",
    "sleek-scroll"
  ],
  "author": "Raphael Aboohi",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.0.1",
    "sass": "^1.62.1",
    "typescript": "^5.5.4",
    "vite": "^8.0.10"
  },
  "peerDependencies": {
    "react": ">=17"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/Raphael2001/Sleek-Scroll/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Raphael2001/Sleek-Scroll"
  }
}
